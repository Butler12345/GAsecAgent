# GAsecAgent 配置示例；请复制为 .env 并填写真实值。

# OpenAI-compatible LLM
GA_LLM_API_KEY=
GA_LLM_BASE_URL=
GA_LLM_MODEL=
GA_LLM_TEMPERATURE=0.6
GA_LLM_TOP_P=0.9
GA_LLM_MAX_TOKENS=20000
GA_LLM_MAX_TURNS=10
GA_HISTORY_MAX_TURNS=50

# 可选 Embedding
GA_EMBEDDING_API_KEY=
GA_EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
GA_EMBEDDING_MODEL=text-embedding-v3
GA_EMBEDDING_DIMENSIONS=1024

# 可选 RAG：仅在启动时选择 yes 后才初始化 Embedding
GA_RAG_CHUNK_SIZE=5000
GA_RAG_TOP_K=1
GA_KNOWLEDGE_BASE_DIR=knowledge_base_docs

# MCP 配置路径（相对路径始终基于项目根目录）
GA_MCP_CONFIG=mcp.json

# Filesystem 与 Fscan MCP
# Filesystem 访问根目录；默认隔离在项目 workspace，避免暴露项目配置
GA_FILESYSTEM_ROOT=workspace
# 官方 Filesystem MCP 2026.8.31 的本地安装入口
GA_FILESYSTEM_MCP_ENTRY=.external\node-mcp\node_modules\@modelcontextprotocol\server-filesystem\dist\index.js
# Fscan 二进制不随仓库提交；仅配置可信来源的本地文件
GA_FSCAN_BINARY=tools\fscan\fscan.exe
# shadow1ng/fscan v2.2.0 Windows x64 官方 release 的 SHA-256
GA_FSCAN_SHA256=5aefcbfa98b8e8814dc415a87e4e7e8716004048857d80b37f03e600b6fd2441

# 可选 Tavily 实时 Web 搜索
TAVILY_API_KEY=
# 官方 Tavily MCP 0.2.22 的本地安装入口
GA_TAVILY_MCP_ENTRY=.external\node-mcp\node_modules\tavily-mcp\build\index.js

# 可选 FOFA 资产情报；FOFA_EMAIL 仅兼容旧配置，当前适配器只使用 FOFA_KEY
FOFA_EMAIL=
FOFA_KEY=
